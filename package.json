{
  "name": "stellerxlets",
  "version": "1.0.0",
  "private": true,
  "description": "StellerXlets game launcher with animated frontend and API backend.",
  "scripts": {
    "dev": "concurrently \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "dev:backend": "node backend/server.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^7.1.4"
  }
}
